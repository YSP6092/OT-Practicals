import numpy as np

def northwest_corner(cost, supply, demand):
    cost = np.array(cost, dtype=int)
    supply = list(supply)
    demand = list(demand)

    # Step 1: Balance the problem if needed
    total_supply, total_demand = sum(supply), sum(demand)
    if total_supply > total_demand:
        # Add dummy destination
        demand.append(total_supply - total_demand)
        cost = np.hstack((cost, np.zeros((cost.shape[0], 1), dtype=int)))
        print(f"Added dummy destination with demand {demand[-1]}")
    elif total_demand > total_supply:
        # Add dummy source
        supply.append(total_demand - total_supply)
        cost = np.vstack((cost, np.zeros((1, cost.shape[1]), dtype=int)))
        print(f"Added dummy source with supply {supply[-1]}")

    m, n = len(supply), len(demand)
    remaining_supply = supply.copy()
    remaining_demand = demand.copy()

    allocation = np.zeros((m, n), dtype=int)
    basic_cells = []  # tracks occupied cells (including degenerate zero ones)

    # Step 2: Northwest Corner Method
    i, j = 0, 0
    while i < m and j < n:
        quantity = min(remaining_supply[i], remaining_demand[j])
        allocation[i, j] = quantity
        basic_cells.append((i, j))

        remaining_supply[i] -= quantity
        remaining_demand[j] -= quantity

        if remaining_supply[i] == 0 and remaining_demand[j] == 0:
            # Degenerate case: move only one step so a zero-valued
            # basic cell is kept, preserving m + n - 1 basic cells
            if j < n - 1:
                j += 1
            else:
                i += 1
        elif remaining_supply[i] == 0:
            i += 1
        else:
            j += 1

    total_cost = int(np.sum(allocation * cost))
    return allocation, total_cost, basic_cells


# Cost per unit
cost = [
    [2, 3, 1],
    [5, 4, 8],
    [5, 6, 8]
]

supply = [30, 40, 20]
demand = [20, 30, 40]

allocation, total_cost, basic_cells = northwest_corner(cost, supply, demand)

print("Allocation Matrix:")
print(allocation)
print("\nBasic cells:", basic_cells)
print("Total Transportation Cost =", total_cost)
